        realtimeCandleLowerWickW := line.new(x1 = candleBodyMidpointBarIndexW, y1 = candleBodyBottomW, x2 = candleBodyMidpointBarIndexW, y2 = htfLowW,        color = candleBorderColorW, width = WICK_WIDTH)
    else
