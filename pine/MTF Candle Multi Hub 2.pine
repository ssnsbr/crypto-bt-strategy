var line realtimeCandleUpperWickHA4H = na
var line realtimeCandleLowerWickHA4H = na

var int candleBodyLeftBarIndexHA4H = bar_index
var int candleBodyRightBarIndexHA4H = na
var int candleBodyMidpointBarIndexHA4H = na

var color candleBodyColorHA4H = na
var color candleBorderColorHA4H = na

//インジケーター設定
var string securitySymbolHA4H = ticker.heikinashi(syminfo.tickerid)
var string securityTimeframeHA4H = "240"

[htfOpenHA4H, htfHighHA4H, htfLowHA4H, htfCloseHA4H, htfTimeHA4H, htfTimeCloseHA4H] = request.security(symbol = securitySymbolHA4H, timeframe = securityTimeframeHA4H, expression = [open, high, low, close, time, time_close], lookahead = barmerge.lookahead_on)

bool isTimeframeChangedHA4H = timeframe.change(securityTimeframeHA4H)

if isTimeframeChangedHA4H
    candleBodyLeftBarIndexHA4H := bar_index
    candleBodyRightBarIndexHA4H := reduceFutureBarIndexToMaximum(candleBodyLeftBarIndexHA4H + int((htfTimeCloseHA4H - htfTimeHA4H) / (time_close - time)))
    candleBodyMidpointBarIndexHA4H := calculateCandleBodyMidpointBarIndex(candleBodyRightBarIndexHA4H)
//end if

float candleBodyTopHA4H = math.max(htfOpenHA4H, htfCloseHA4H)
float candleBodyBottomHA4H = math.min(htfOpenHA4H, htfCloseHA4H)

bool isFallingHA4H = htfOpenHA4H > htfCloseHA4H
bool isRisingHA4H = htfOpenHA4H < htfCloseHA4H

// 枠とひげの色
candleBorderColorHA4H := determineDirectionColor(isFallingHA4H, isRisingHA4H, bearBorderColorHA4H, bullBorderColorHA4H)
candleBodyColorHA4H := determineDirectionColor(isFallingHA4H, isRisingHA4H, bearBodyColorHA4H, bullBodyColorHA4H)

if enableHeikinAshi4H  // 4時間足 平均足のローソク足が有効な場合のみ描画
    if isTimeframeChangedHA4H
        realtimeCandleBodyHA4H := box.new(left = candleBodyLeftBarIndexHA4H, top = candleBodyTopHA4H, right = candleBodyRightBarIndexHA4H, bottom = candleBodyBottomHA4H, bgcolor = candleBodyColorHA4H, border_color = candleBorderColorHA4H, border_width = BORDER_WIDTH)
    else
        box.set_border_color(realtimeCandleBodyHA4H, candleBorderColorHA4H)
        box.set_bgcolor(realtimeCandleBodyHA4H, candleBodyColorHA4H)
        box.set_top(realtimeCandleBodyHA4H, candleBodyTopHA4H)
        box.set_bottom(realtimeCandleBodyHA4H, candleBodyBottomHA4H)

    // ひげの描画
    if isTimeframeChangedHA4H
        realtimeCandleUpperWickHA4H := line.new(x1 = candleBodyMidpointBarIndexHA4H, y1 = htfHighHA4H,          x2 = candleBodyMidpointBarIndexHA4H, y2 = candleBodyTopHA4H, color = candleBorderColorHA4H, width = WICK_WIDTH)
        realtimeCandleLowerWickHA4H := line.new(x1 = candleBodyMidpointBarIndexHA4H, y1 = candleBodyBottomHA4H, x2 = candleBodyMidpointBarIndexHA4H, y2 = htfLowHA4H,        color = candleBorderColorHA4H, width = WICK_WIDTH)
    else
        line.set_color(realtimeCandleUpperWickHA4H, candleBorderColorHA4H)
        line.set_y1(realtimeCandleUpperWickHA4H, htfHighHA4H)
        line.set_y2(realtimeCandleUpperWickHA4H, candleBodyTopHA4H)
        line.set_color(realtimeCandleLowerWickHA4H, candleBorderColorHA4H)
        line.set_y1(realtimeCandleLowerWickHA4H, candleBodyBottomHA4H)
        line.set_y2(realtimeCandleLowerWickHA4H, htfLowHA4H)

