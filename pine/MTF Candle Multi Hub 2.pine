// Heikin Ashi Colors
bullBodyColorHA = input.color(color.rgb(35, 150, 140), title="▲ HA Body", inline="▲", group="Heikin Ashi Colors")
bearBodyColorHA = input.color(color.rgb(255, 45, 38), title="▼ HA Body", inline="▼", group="Heikin Ashi Colors")
bullWickColorHA = input.color(color.rgb(35, 150, 140), title="▲ HA Wick", inline="▲", group="Heikin Ashi Colors")
bearWickColorHA = input.color(color.rgb(255, 45, 38), title="▼ HA Wick", inline="▼", group="Heikin Ashi Colors")
bullBorderColorHA = input.color(color.rgb(35, 150, 140), title="▲ HA Border", inline="▲", group="Heikin Ashi Colors")
bearBorderColorHA = input.color(color.rgb(255, 45, 38), title="▼ HA Border", inline="▼", group="Heikin Ashi Colors")

// Heikin Ashi の値を取得
[haOpen, haHigh, haLow, haClose] = request.security(ticker.heikinashi(syminfo.tickerid), timeframe.period, [open, high, low, close])

// 1分足であるかを判定
bool is1MinuteChart = (timeframe.isminutes and timeframe.multiplier == 1)

// Heikin Ashi キャンドルの色設定
candleColorHA = haClose >= haOpen ? bullBodyColorHA : bearBodyColorHA
wickColorHA = haClose >= haOpen ? bullWickColorHA : bearWickColorHA
borderColorHA = haClose >= haOpen ? bullBorderColorHA : bearBorderColorHA

// キャンドルを表示するかどうかのフラグ
plotHeikinAshi = showHeikinAshi and (displayOnAllTimeframes or is1MinuteChart)

// Heikin Ashi キャンドルの描画
plotcandle(plotHeikinAshi ? haOpen : na,
           plotHeikinAshi ? haHigh : na,
           plotHeikinAshi ? haLow : na,
           plotHeikinAshi ? haClose : na,
           color=candleColorHA,
           wickcolor=wickColorHA,
           bordercolor=borderColorHA)

