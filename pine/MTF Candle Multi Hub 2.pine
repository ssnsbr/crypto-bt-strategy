// ＃＃＃＃＃＃＃＃＃＃　ZigZag　＃＃＃＃＃＃＃＃＃ここからzigzagコード
// ZigZagの設定


const int UP = 1
const int DOWN = -1

// @type 各バーのデータをラップするオブジェクト
type Bar
    int time = time
    int x = bar_index
    float high = high
    float low = low

// @function バーの高値ポイントを取得する
// @returns バーの高値ポイント
method highPoint(Bar this) =>
    chart.point.new(this.time, this.x, this.high)

// @function バーの安値ポイントを取得する
// @returns バーの安値ポイント
method lowPoint(Bar this) =>
    chart.point.new(this.time, this.x, this.low)

// @type ZigZagアルゴリズムの設定
type Settings
    int swingLen
    color lineColor
    string lineStyle
    int lineWidth

// @type チャート上のスイング
type Swing
    Settings settings
    Swing prev
    chart.point start
    chart.point end
    line[] hLines

// @function スイングを初期化する
method init(Swing this, Settings settings, Swing prev, chart.point start, chart.point end) =>
    this.settings := settings
    this.prev := prev
    this.start := start
    this.end := end
    this.hLines := array.new_line(0)
    this

// @function スイングの方向を取得する
// @returns スイングの方向
method direction(Swing this) =>
    this.end.price >= this.start.price ? UP : DOWN

// @function スイングの長さを取得する
// @returns スイングの長さ
method len(Swing this) =>
    this.end.index - this.start.index + 1

// @function スイングの振幅を取得する
// @returns スイングの振幅
method amplitude(Swing this) =>
    math.abs(this.end.price - this.start.price)

// @function スイングが有効かどうかをチェックする。スイングが十分なバーを持つか、前のスイングよりも振幅が大きい場合、有効とされる。
// @returns スイングが有効かどうか
method isValid(Swing this) =>
    if this.len() >= this.settings.swingLen
        true
    else if not na(this.prev)
        this.amplitude() > this.prev.amplitude()
    else
        false

// @function スイングが指定されたバーによって拡張されるかどうかをチェックする
// @param bar チェック対象のバー
// @returns スイングが拡張されるかどうか
method isExtendedBy(Swing this, Bar bar) =>
    this.direction() == UP ? bar.high > this.end.price : bar.low < this.end.price

// @function スイングを指定されたバーに拡張する
// @param 拡張するバー
method extend(Swing this, Bar bar) =>
    chart.point end = this.direction() == UP ? bar.highPoint() : bar.lowPoint()
    this.end := end

// @function スイングの水平線を描画する
method drawHLines(Swing this, color hLineColor, string hLineStyle, int hLineWidth, int hLineLength) =>
    // 既存の水平線を削除
    for l in this.hLines
        l.delete()
    array.clear(this.hLines)
    // 新しい水平線を作成
    line hLine1 = line.new(x1=this.start.time, y1=this.start.price, x2=this.start.time + hLineLength * 60 * 1000, y2=this.start.price, color=hLineColor, width=hLineWidth, style=hLineStyle, xloc=xloc.bar_time)
    line hLine2 = line.new(x1=this.end.time, y1=this.end.price, x2=this.end.time + hLineLength * 60 * 1000, y2=this.end.price, color=hLineColor, width=hLineWidth, style=hLineStyle, xloc=xloc.bar_time)
    array.push(this.hLines, hLine1)
    array.push(this.hLines, hLine2)

// @type ZigZagアルゴリズム
type ZigZag
    Settings _settings
    chart.point _firstPoint
    Swing[] _swings
    polyline _swingsPoly

// @function ZigZagオブジェクトを初期化する
// @param settings 設定オブジェクト
// @returns 初期化されたインスタンス
method init(ZigZag this, Settings settings) =>
    this._settings := settings
    this._swings := array.new<Swing>()
    this

// @function 新しいバーを分析してZigZagを更新する
// @param bar 新しいバー。naが提供された場合、自動的にバーを構築して使用する。
method tick(ZigZag this, Bar bar = na) =>
    Bar b = na(bar) ? Bar.new() : bar
    int size = this._swings.size()
    if size == 0
        if na(this._firstPoint)
            this._firstPoint := b.lowPoint()
        else
            if b.low < this._firstPoint.price
                this._firstPoint := b.lowPoint()
            else
                Swing swing = Swing.new().init(
                  this._settings,
                  prev = na,
                  start = this._firstPoint,
                  end = b.highPoint())
                this._swings.push(swing)
    else
        Swing s = this._swings.last()
        Swing prevS = size > 1 ? this._swings.get(size - 2) : na
        bool extendedPrev = if not na(prevS)
            if prevS.isExtendedBy(b) and not s.isValid()
                this._swings.pop()
                prevS.extend(b)
                true
        if not extendedPrev
            if s.isExtendedBy(b)
                s.extend(b)
            else if s.isValid()
                Swing newSwing = Swing.new().init(
                  this._settings,
                  prev = s,
                  start = s.end,
                  end = s.direction() == UP ? b.lowPoint() : b.highPoint())
                this._swings.push(newSwing)
    0

// @function チャートにZigZagラインと水平線を描画する
method draw(ZigZag this, bool showHLines, color hLineColor, string hLineStyle, int hLineWidth, int hLineCount, int hLineLength) =>
    chart.point[] points = array.new<chart.point>()
    int drawnLines = 0
    int swingCount = this._swings.size()
    for [i, s] in this._swings
        if i == 0
            points.push(s.start)
        points.push(s.end)
        // 最新のスイングではなく、1つ前の確定したスイングから水平線を描画
        if showHLines and drawnLines < hLineCount - 1 and i >= swingCount - hLineCount
            s.drawHLines(hLineColor, hLineStyle, hLineWidth, hLineLength)
            drawnLines := drawnLines + 1
    if not na(this._swingsPoly)
        this._swingsPoly.delete()
    this._swingsPoly := polyline.new(
      points,
      xloc = xloc.bar_time,
      line_color = this._settings.lineColor,
      line_style = this._settings.lineStyle,
      line_width = this._settings.lineWidth)

// --- ユーザー入力に基づく１本目のZigZag設定 ---

swingLengthInput2 = input.int(5, "Swing Length", minval = 1,inline="ZigZag 1", group="＿＿ZigZag 1 ＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿")
lineColorInput2 = input.color(#cf2626, " Color",inline="ZigZag 1")
lineStyleInput2 = input.string("Solid", "Style", options = ["Solid", "Dashed", "Dotted"],inline="ZigZag 2")
lineWidthInput2 = input.int(1, " Width", minval = 1,inline="ZigZag 2")

hLineShow2 = input.bool(false, "水平線 ON/OFF horizontal line", inline="ZigZag 1-2", group="＿＿ZigZag 1 horizon ＿＿")
hLineColor2 = input.color(#cf2626, " Color", inline="ZigZag 1-2")
hLineStyle2 = input.string("Solid", "Style", options = ["Solid", "Dashed", "Dotted"], inline="ZigZag 1-2")
hLineWidth2 = input.int(1, "水平線 Width", minval = 1, inline="ZigZag 2-1")
hLineCount2 = input.int(2, "Line Count 本数", minval = 2, maxval = 20, inline="ZigZag 2-1")
hLineLength2 = input.int(20000, "line length 長さ", minval = 1, maxval = 100000, inline="ZigZag 2-1")

lineStyleMap2 = lineStyleInput2 == "Solid" ? line.style_solid : lineStyleInput2 == "Dashed" ? line.style_dashed : line.style_dotted
hLineStyleMap2 = hLineStyle2 == "Solid" ? line.style_solid : hLineStyle2 == "Dashed" ? line.style_dashed : line.style_dotted

var ZigZag zz2 = ZigZag.new().init(
  Settings.new(
      swingLen = swingLengthInput2,
      lineColor = lineColorInput2,
      lineStyle = lineStyleMap2,
      lineWidth = lineWidthInput2))
zz2.tick()

if barstate.islast and showLine2
