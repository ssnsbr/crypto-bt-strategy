//@version=5
indicator(title = 'MTF Candle Multi Hub', shorttitle = 'MTF Candle Multi Hub', overlay = true, max_lines_count = 500, max_boxes_count = 250, dynamic_requests=true)


//コードここから

//入力設定
var string CANDLE_GROUP = 'CANDLE SETTINGS ON/OFF'
// ローソク足のオンオフ機能
var bool enableCandles5M = input.bool(false, title="5M Candle ON/OFF", group = CANDLE_GROUP)


// 平均足のローソク足のオンオフ機能
var string HEIKIN_ASHI_CANDLE_GROUP = 'Heikin Ashi CANDLE SETTINGS ON/OFF'
// Heikin Ashi Candle ON/OFF
showHeikinAshi = input(false, title="1M Heikin Ashi Candle ON/OFF", group = HEIKIN_ASHI_CANDLE_GROUP)
// 全ての時間足で表示するかどうか
displayOnAllTimeframes = input.bool(false, title="(View Heikin Ashi in all time frames)", group = HEIKIN_ASHI_CANDLE_GROUP, tooltip=" Valid only if 1M Heikin Ashi Candle ON\n【1M Heikin Ashi Candle ONの場合のみ有効】")




// ZigZagラインの表示/非表示を制御するチェックボックス
var string ZigZag_GROUP = 'ZigZag SETTINGS ON/OFF'


showLine2 = input.bool(false, "■■【ZigZag 1 ON/OFF】■■", group = ZigZag_GROUP, tooltip="Detailed settings for ZigZag can be found below【ZigZagの詳細設定は下方にあります】")
showLine1 = input.bool(false, "■■【ZigZag 2 ON/OFF】■■", group = ZigZag_GROUP)
//
// MA設定ここから
show_ma1 = input.bool(title="Show MA1", defval=false)
show_ma2 = input.bool(title="Show MA2", defval=false)
show_ma3 = input.bool(title="Show MA3", defval=false)
show_ma4 = input.bool(title="Show MA4", defval=false)

// 色のON/OFF設定
fill_color = input.bool(title="Show MA Cloud ON/OFF【MA間の色】", defval=false)

ma_type1 = input.string(title="MA1 Type", defval="EMA", options=["EMA", "SMA"], inline="MA1")
ma_periods1 = input.int(title="　MA1 Period", defval=10, inline="MA1")
ma_type2 = input.string(title="MA2 Type", defval="EMA", options=["EMA", "SMA"], inline="MA2")
ma_periods2 = input.int(title="　MA2 Period", defval=20, inline="MA2")
ma_type3 = input.string(title="MA3 Type", defval="EMA", options=["EMA", "SMA"], inline="MA3")
ma_periods3 = input.int(title="　MA3 Period", defval=75, inline="MA3")
ma_type4 = input.string(title="MA4 Type", defval="EMA", options=["EMA", "SMA"], inline="MA4")
ma_periods4 = input.int(title="　MA4 Period", defval=200, inline="MA4")

// MA計算
ma1 = ma_type1 == "EMA" ? ta.ema(close, ma_periods1) : ta.sma(close, ma_periods1)
ma2 = ma_type2 == "EMA" ? ta.ema(close, ma_periods2) : ta.sma(close, ma_periods2)
ma3 = ma_type3 == "EMA" ? ta.ema(close, ma_periods3) : ta.sma(close, ma_periods3)
ma4 = ma_type4 == "EMA" ? ta.ema(close, ma_periods4) : ta.sma(close, ma_periods4)

// プロット
p1 = plot(show_ma1 ? ma1 : na, color=#000000, linewidth=2, title="MA1")

// MA2の色を上昇・下降で変更
ma2_color = ma2 > ma2[1] ? color.rgb(35, 150, 140) : color.rgb(255, 45, 38)
p2 = plot(show_ma2 ? ma2 : na, color=ma2_color, linewidth=2, title="MA2")

p3 = plot(show_ma3 ? ma3 : na, color=color.blue, linewidth=2, title="MA3")
p4 = plot(show_ma4 ? ma4 : na, color=#000000, linewidth=2, title="MA4")

// MAプラス設定ここから
// 移動平均線の間に色をつける
fill(p3, p4, color=fill_color ? (ma3 > ma4 ? color.new(color.green, 80) : color.new(color.red, 80)) : na)
fill(p2, p3, color=fill_color ? (ma2 > ma3 ? color.new(color.green, 80) : color.new(color.red, 80)) : na)
fill(p1, p2, color=fill_color ? (ma1 > ma2 ? color.new(color.green, 80) : color.new(color.red, 80)) : na)
// MAプラス設定ここまで
// MA設定ここまで




// スタイルタブに表示されるカラー設定
color bullBodyColor1H = input.color(color.new(color.green, 90), title="▲ Body", group="1H COLOR———————————————————————", inline="bullColors1H")
color bullBorderColor1H = input.color(color.green, title="▲ Border", group="1H COLOR———————————————————————", inline="bullColors1H")
color bearBodyColor1H = input.color(color.new(color.red, 90), title="▼ Body", group="1H COLOR———————————————————————", inline="bearColors1H")
color bearBorderColor1H = input.color(color.red, title="▼ Border", group="1H COLOR———————————————————————", inline="bearColors1H")

//グローバル変数 
var box realtimeCandleBody = na
var line realtimeCandleUpperWick = na
var line realtimeCandleLowerWick = na

var int candleBodyLeftBarIndex = bar_index
var int candleBodyRightBarIndex = na
var int candleBodyMidpointBarIndex = na

var color candleBodyColor = na
var color candleBorderColor = na

// 固定の設定値
var int BORDER_WIDTH = 1  // 枠の太さ
var int WICK_WIDTH = 2     // ひげの太さ

//関数
determineDirectionColor(bool _isFalling, bool _isRising, color _fallingColor, color _risingColor) =>
    _isFalling ? _fallingColor :
     _isRising ? _risingColor :
     na

calculateCandleBodyMidpointBarIndex(int _projectedRightBarIndex)=>
    candleBodyLeftBarIndex + math.ceil( ( _projectedRightBarIndex - candleBodyLeftBarIndex ) / 2 )

reduceFutureBarIndexToMaximum(int _proposedFutureBarIndex)=>
    ( _proposedFutureBarIndex - last_bar_index > 500 ) ?  last_bar_index + 500 : _proposedFutureBarIndex

//インジケーター設定


// コードここから5分足

//入力設定
var string CANDLE_GROUP_5M = '5M CANDLE SETTINGS'
// 5分足のローソク足のオンオフ機能を追加


var string CANDLE_COLOR_GROUP_5M = '5M COLOR'
// 5分足の色の配置設定
var color bullBodyColor5M = input.color(color.new(color.green, 90), title="▲ Body", inline="bullColors5M", group=CANDLE_COLOR_GROUP_5M)
var color bullBorderColor5M = input.color(color.green, title="▲ Border", inline="bullColors5M", group=CANDLE_COLOR_GROUP_5M)
var color bearBodyColor5M = input.color(color.new(color.red, 90), title="▼ Body", inline="bearColors5M", group=CANDLE_COLOR_GROUP_5M)
var color bearBorderColor5M = input.color(color.red, title="▼ Border", inline="bearColors5M", group=CANDLE_COLOR_GROUP_5M)

//グローバル変数 
var box realtimeCandleBody5M = na
var line realtimeCandleUpperWick5M = na
var line realtimeCandleLowerWick5M = na

var int candleBodyLeftBarIndex5M = bar_index
var int candleBodyRightBarIndex5M = na
var int candleBodyMidpointBarIndex5M = na

var color candleBodyColor5M = na
var color candleBorderColor5M = na

//インジケーター設定
var string securitySymbol5M = syminfo.tickerid
var string securityTimeframe5M = "5"

[htfOpen5M, htfHigh5M, htfLow5M, htfClose5M, htfTime5M, htfTimeClose5M] = request.security(symbol = securitySymbol5M, timeframe = securityTimeframe5M, expression = [open, high, low, close, time, time_close], lookahead = barmerge.lookahead_on)

bool isTimeframeChanged5M = timeframe.change(securityTimeframe5M)

if isTimeframeChanged5M
    candleBodyLeftBarIndex5M := bar_index
    candleBodyRightBarIndex5M := reduceFutureBarIndexToMaximum(candleBodyLeftBarIndex5M + int((htfTimeClose5M - htfTime5M) / (time_close - time)))
    candleBodyMidpointBarIndex5M := calculateCandleBodyMidpointBarIndex(candleBodyRightBarIndex5M)
//end if

float candleBodyTop5M = math.max(htfOpen5M, htfClose5M)
float candleBodyBottom5M = math.min(htfOpen5M, htfClose5M)

bool isFalling5M = htfOpen5M > htfClose5M
bool isRising5M = htfOpen5M < htfClose5M

// 枠とひげの色
candleBorderColor5M := determineDirectionColor(isFalling5M, isRising5M, bearBorderColor5M, bullBorderColor5M)
candleBodyColor5M := determineDirectionColor(isFalling5M, isRising5M, bearBodyColor5M, bullBodyColor5M)

if enableCandles5M  // 5分足のローソク足が有効な場合のみ描画
    if isTimeframeChanged5M
        realtimeCandleBody5M := box.new(left = candleBodyLeftBarIndex5M, top = candleBodyTop5M, right = candleBodyRightBarIndex5M, bottom = candleBodyBottom5M, bgcolor = candleBodyColor5M, border_color = candleBorderColor5M, border_width = BORDER_WIDTH)
    else
        box.set_border_color(realtimeCandleBody5M, candleBorderColor5M)
        box.set_bgcolor(realtimeCandleBody5M, candleBodyColor5M)
        box.set_top(realtimeCandleBody5M, candleBodyTop5M)
        box.set_bottom(realtimeCandleBody5M, candleBodyBottom5M)


// ひげの描画
if enableCandles5M
    if isTimeframeChanged5M
        // 上ひげの描画
        realtimeCandleUpperWick5M := line.new(x1 = bar_index, y1 = htfHigh5M, x2 = bar_index, y2 = candleBodyTop5M, color = candleBorderColor5M, width = WICK_WIDTH)

        // 下ひげの描画
        realtimeCandleLowerWick5M := line.new(x1 = bar_index, y1 = candleBodyBottom5M, x2 = bar_index, y2 = htfLow5M, color = candleBorderColor5M, width = WICK_WIDTH)
    else
        // 既存のひげを更新
        line.set_color(realtimeCandleUpperWick5M, candleBorderColor5M)
        line.set_y1(realtimeCandleUpperWick5M, htfHigh5M)
        line.set_y2(realtimeCandleUpperWick5M, candleBodyTop5M)
        line.set_x1(realtimeCandleUpperWick5M, bar_index)
        line.set_x2(realtimeCandleUpperWick5M, bar_index)

        line.set_color(realtimeCandleLowerWick5M, candleBorderColor5M)
        line.set_y1(realtimeCandleLowerWick5M, candleBodyBottom5M)
        line.set_y2(realtimeCandleLowerWick5M, htfLow5M)
        line.set_x1(realtimeCandleLowerWick5M, bar_index)
        line.set_x2(realtimeCandleLowerWick5M, bar_index)
else
    // ひげを非表示にする
    if not na(realtimeCandleUpperWick5M)
        line.delete(realtimeCandleUpperWick5M)
    if not na(realtimeCandleLowerWick5M)
        line.delete(realtimeCandleLowerWick5M)

// コードここまで5分足

/// コードここから15分足

//入力設定
var string CANDLE_GROUP_15M = '15M CANDLE SETTINGS'
// 15分足のローソク足のオンオフ機能を追加
var bool enableCandles15M = input.bool(false, title="15M Candle ON/OFF", group = CANDLE_GROUP)

var string CANDLE_COLOR_GROUP_15M = '15M COLOR'
// 15分足の色の配置設定
var color bullBodyColor15M = input.color(color.new(color.green, 90), title="▲ Body", inline="bullColors15M", group=CANDLE_COLOR_GROUP_15M)
var color bullBorderColor15M = input.color(color.green, title="▲ Border", inline="bullColors15M", group=CANDLE_COLOR_GROUP_15M)
var color bearBodyColor15M = input.color(color.new(color.red, 90), title="▼ Body", inline="bearColors15M", group=CANDLE_COLOR_GROUP_15M)
var color bearBorderColor15M = input.color(color.red, title="▼ Border", inline="bearColors15M", group=CANDLE_COLOR_GROUP_15M)

//グローバル変数 
var box realtimeCandleBody15M = na
var line realtimeCandleUpperWick15M = na
var line realtimeCandleLowerWick15M = na

var int candleBodyLeftBarIndex15M = bar_index
var int candleBodyRightBarIndex15M = na
var int candleBodyMidpointBarIndex15M = na

var color candleBodyColor15M = na
var color candleBorderColor15M = na

//インジケーター設定
var string securitySymbol15M = syminfo.tickerid
var string securityTimeframe15M = "15"

[htfOpen15M, htfHigh15M, htfLow15M, htfClose15M, htfTime15M, htfTimeClose15M] = request.security(symbol = securitySymbol15M, timeframe = securityTimeframe15M, expression = [open, high, low, close, time, time_close], lookahead = barmerge.lookahead_on)

bool isTimeframeChanged15M = timeframe.change(securityTimeframe15M)

if isTimeframeChanged15M
    candleBodyLeftBarIndex15M := bar_index
    candleBodyRightBarIndex15M := reduceFutureBarIndexToMaximum(candleBodyLeftBarIndex15M + int((htfTimeClose15M - htfTime15M) / (time_close - time)))
    candleBodyMidpointBarIndex15M := calculateCandleBodyMidpointBarIndex(candleBodyRightBarIndex15M)
//end if

float candleBodyTop15M = math.max(htfOpen15M, htfClose15M)
float candleBodyBottom15M = math.min(htfOpen15M, htfClose15M)

bool isFalling15M = htfOpen15M > htfClose15M
bool isRising15M = htfOpen15M < htfClose15M

// 枠とひげの色
candleBorderColor15M := determineDirectionColor(isFalling15M, isRising15M, bearBorderColor15M, bullBorderColor15M)
candleBodyColor15M := determineDirectionColor(isFalling15M, isRising15M, bearBodyColor15M, bullBodyColor15M)

if enableCandles15M  // 15分足のローソク足が有効な場合のみ描画
    if isTimeframeChanged15M
        realtimeCandleBody15M := box.new(left = candleBodyLeftBarIndex15M, top = candleBodyTop15M, right = candleBodyRightBarIndex15M, bottom = candleBodyBottom15M, bgcolor = candleBodyColor15M, border_color = candleBorderColor15M, border_width = BORDER_WIDTH)
    else
        box.set_border_color(realtimeCandleBody15M, candleBorderColor15M)
        box.set_bgcolor(realtimeCandleBody15M, candleBodyColor15M)
        box.set_top(realtimeCandleBody15M, candleBodyTop15M)
        box.set_bottom(realtimeCandleBody15M, candleBodyBottom15M)


// ひげの描画
if enableCandles15M
    if isTimeframeChanged15M
        // 上ひげの描画
        realtimeCandleUpperWick15M := line.new(x1 = bar_index, y1 = htfHigh15M, x2 = bar_index, y2 = candleBodyTop15M, color = candleBorderColor15M, width = WICK_WIDTH)

        // 下ひげの描画
        realtimeCandleLowerWick15M := line.new(x1 = bar_index, y1 = candleBodyBottom15M, x2 = bar_index, y2 = htfLow15M, color = candleBorderColor15M, width = WICK_WIDTH)
    else
        // 既存のひげを更新
        line.set_color(realtimeCandleUpperWick15M, candleBorderColor15M)
        line.set_y1(realtimeCandleUpperWick15M, htfHigh15M)
        line.set_y2(realtimeCandleUpperWick15M, candleBodyTop15M)
        line.set_x1(realtimeCandleUpperWick15M, bar_index)
        line.set_x2(realtimeCandleUpperWick15M, bar_index)

        line.set_color(realtimeCandleLowerWick15M, candleBorderColor15M)
        line.set_y1(realtimeCandleLowerWick15M, candleBodyBottom15M)
        line.set_y2(realtimeCandleLowerWick15M, htfLow15M)
        line.set_x1(realtimeCandleLowerWick15M, bar_index)
        line.set_x2(realtimeCandleLowerWick15M, bar_index)

// コードここまで15分足

//コードここから１時間足

var bool enableCandles = input.bool(true, title="1H Candle ON/OFF", group = CANDLE_GROUP)
var string securitySymbol = syminfo.tickerid
var string securityTimeframe = "60"

[htfOpen, htfHigh, htfLow, htfClose, htfTime, htfTimeClose] = request.security(symbol = securitySymbol, timeframe = securityTimeframe,expression = [open, high, low, close, time, time_close], lookahead = barmerge.lookahead_on)

bool isTimeframeChanged = timeframe.change(securityTimeframe)

if isTimeframeChanged
    candleBodyLeftBarIndex := bar_index
    candleBodyRightBarIndex := reduceFutureBarIndexToMaximum(candleBodyLeftBarIndex + int((htfTimeClose - htfTime) / (time_close - time)))
    candleBodyMidpointBarIndex := calculateCandleBodyMidpointBarIndex(candleBodyRightBarIndex)
//end if

float candleBodyTop = math.max(htfOpen, htfClose)
float candleBodyBottom = math.min(htfOpen, htfClose)

bool isFalling = htfOpen > htfClose
bool isRising = htfOpen < htfClose

// 枠とひげの色
candleBorderColor := determineDirectionColor(isFalling, isRising, bearBorderColor1H, bullBorderColor1H)
candleBodyColor := determineDirectionColor(isFalling, isRising, bearBodyColor1H, bullBodyColor1H)

if enableCandles  // ローソク足が有効な場合のみ描画
    if isTimeframeChanged
        realtimeCandleBody := box.new(left = candleBodyLeftBarIndex, top = candleBodyTop, right = candleBodyRightBarIndex, bottom = candleBodyBottom,bgcolor = candleBodyColor, border_color = candleBorderColor, border_width = BORDER_WIDTH)
    else
        box.set_border_color(realtimeCandleBody, candleBorderColor)
        box.set_bgcolor(realtimeCandleBody, candleBodyColor)
        box.set_top(realtimeCandleBody, candleBodyTop)
        box.set_bottom(realtimeCandleBody, candleBodyBottom)

    // ひげの描画
    if isTimeframeChanged
        realtimeCandleUpperWick := line.new(x1 = candleBodyMidpointBarIndex, y1 = htfHigh,          x2 = candleBodyMidpointBarIndex, y2 = candleBodyTop, color = candleBorderColor, width = WICK_WIDTH)
        realtimeCandleLowerWick := line.new(x1 = candleBodyMidpointBarIndex, y1 = candleBodyBottom, x2 = candleBodyMidpointBarIndex, y2 = htfLow,        color = candleBorderColor, width = WICK_WIDTH)
    else
        line.set_color(realtimeCandleUpperWick, candleBorderColor)
        line.set_y1(realtimeCandleUpperWick, htfHigh)
        line.set_y2(realtimeCandleUpperWick, candleBodyTop)
        line.set_color(realtimeCandleLowerWick, candleBorderColor)
        line.set_y1(realtimeCandleLowerWick, candleBodyBottom)
        line.set_y2(realtimeCandleLowerWick, htfLow)

//コード1時間足ここまで
//コードここから4時間足

