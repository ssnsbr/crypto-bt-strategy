// ZigZag 2の時間軸に基づいてSwing Lengthを決定
getSwingLengthForTimeframe(string tf) =>
    if tf == "1"
        swingLength1Min_ZZ2
    else if tf == "5"
        swingLength5Min_ZZ2
    else if tf == "15"
        swingLength15Min_ZZ2
    else if tf == "30"
        swingLength30Min_ZZ2
    else if tf == "60"
        swingLength1Hour_ZZ2
    else if tf == "240"
        swingLength4Hour_ZZ2
    else if tf == "D"
        swingLengthDaily_ZZ2
    else if tf == "W"
        swingLengthWeekly_ZZ2
    else
        25  // デフォルト値

swingLengthForZZ2 = getSwingLengthForTimeframe(zigzagTimeframe)

// Higher Timeframe データの取得
[htfHigh1, htfLow1, htfTime1, htfBarIndex1] = request.security(syminfo.tickerid, zigzagTimeframe, [high, low, time, bar_index], lookahead = barmerge.lookahead_off)

// ZigZag 2の初期化
var ZigZag zz1 = ZigZag.new().init(
  Settings.new(
      swingLen = swingLengthForZZ2,
      lineColor = lineColorInput1,
      lineStyle = lineStyleMap1,
      lineWidth = lineWidthInput1))

// 毎バーHTFデータでZigZagを更新
Bar htfBar = Bar.new(htfTime1, bar_index, htfHigh1, htfLow1)
zz1.tick(htfBar)

if barstate.islast and showLine1
    zz1.draw(hLineShow1, hLineColor1, hLineStyleMap1, hLineWidth1, hLineCount1, hLineLength1)