//コードここから日足

//入力設定
var string CANDLE_GROUP_D = 'Daily CANDLE SETTINGS'
// 日足のローソク足のオンオフ機能を追加
var bool enableCandlesD = input.bool(false, title="Daily Candle ON/OFF", group = CANDLE_GROUP)

var string CANDLE_COLOR_GROUP_D = 'Daily COLOR'
// 日足の色の配置設定
var color bullBodyColorD = input.color(color.new(color.green, 90), title="▲ Body", inline="bullColorsD", group=CANDLE_COLOR_GROUP_D)
var color bullBorderColorD = input.color(color.green, title="▲ Border", inline="bullColorsD", group=CANDLE_COLOR_GROUP_D)
var color bearBodyColorD = input.color(color.new(color.red, 90), title="▼ Body", inline="bearColorsD", group=CANDLE_COLOR_GROUP_D)
var color bearBorderColorD = input.color(color.red, title="▼ Border", inline="bearColorsD", group=CANDLE_COLOR_GROUP_D)

//グローバル変数 
var box realtimeCandleBodyD = na
var line realtimeCandleUpperWickD = na
var line realtimeCandleLowerWickD = na

var int candleBodyLeftBarIndexD = bar_index
var int candleBodyRightBarIndexD = na
var int candleBodyMidpointBarIndexD = na

var color candleBodyColorD = na
var color candleBorderColorD = na

//インジケーター設定
var string securitySymbolD = syminfo.tickerid
var string securityTimeframeD = "D"

[htfOpenD, htfHighD, htfLowD, htfCloseD, htfTimeD, htfTimeCloseD] = request.security(symbol = securitySymbolD, timeframe = securityTimeframeD, expression = [open, high, low, close, time, time_close], lookahead = barmerge.lookahead_on)

bool isTimeframeChangedD = timeframe.change(securityTimeframeD)

if isTimeframeChangedD
    candleBodyLeftBarIndexD := bar_index
    candleBodyRightBarIndexD := reduceFutureBarIndexToMaximum(candleBodyLeftBarIndexD + int((htfTimeCloseD - htfTimeD) / (time_close - time)))
    candleBodyMidpointBarIndexD := calculateCandleBodyMidpointBarIndex(candleBodyRightBarIndexD)
//end if

float candleBodyTopD = math.max(htfOpenD, htfCloseD)
float candleBodyBottomD = math.min(htfOpenD, htfCloseD)

bool isFallingD = htfOpenD > htfCloseD
bool isRisingD = htfOpenD < htfCloseD

// 枠とひげの色
candleBorderColorD := determineDirectionColor(isFallingD, isRisingD, bearBorderColorD, bullBorderColorD)
candleBodyColorD := determineDirectionColor(isFallingD, isRisingD, bearBodyColorD, bullBodyColorD)

if enableCandlesD  // 日足のローソク足が有効な場合のみ描画
    if isTimeframeChangedD
        realtimeCandleBodyD := box.new(left = candleBodyLeftBarIndexD, top = candleBodyTopD, right = candleBodyRightBarIndexD, bottom = candleBodyBottomD, bgcolor = candleBodyColorD, border_color = candleBorderColorD, border_width = BORDER_WIDTH)
    else
        box.set_border_color(realtimeCandleBodyD, candleBorderColorD)
        box.set_bgcolor(realtimeCandleBodyD, candleBodyColorD)
        box.set_top(realtimeCandleBodyD, candleBodyTopD)
        box.set_bottom(realtimeCandleBodyD, candleBodyBottomD)

    // ひげの描画
    if isTimeframeChangedD
        realtimeCandleUpperWickD := line.new(x1 = candleBodyMidpointBarIndexD, y1 = htfHighD,          x2 = candleBodyMidpointBarIndexD, y2 = candleBodyTopD, color = candleBorderColorD, width = WICK_WIDTH)
        realtimeCandleLowerWickD := line.new(x1 = candleBodyMidpointBarIndexD, y1 = candleBodyBottomD, x2 = candleBodyMidpointBarIndexD, y2 = htfLowD,        color = candleBorderColorD, width = WICK_WIDTH)
    else
        line.set_color(realtimeCandleUpperWickD, candleBorderColorD)
        line.set_y1(realtimeCandleUpperWickD, htfHighD)
        line.set_y2(realtimeCandleUpperWickD, candleBodyTopD)
        line.set_color(realtimeCandleLowerWickD, candleBorderColorD)
        line.set_y1(realtimeCandleLowerWickD, candleBodyBottomD)
        line.set_y2(realtimeCandleLowerWickD, htfLowD)

//コードここまで日足
