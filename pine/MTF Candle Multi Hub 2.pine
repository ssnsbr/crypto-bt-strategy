swingLength30Min_ZZ2 = input.int(20, "・30M） Swing Length", group="＿＿ZigZag 2 Swing Length＿＿")
swingLength1Hour_ZZ2 = input.int(25, "・1H） Swing Length", group="＿＿ZigZag 2 Swing Length＿＿")
swingLength4Hour_ZZ2 = input.int(50, "・4H） Swing Length", group="＿＿ZigZag 2 Swing Length＿＿")
